# proxy forwards them to the Flask server on 127.0.0.1:5000.
# In production (e.g. Vercel/Netlify), set to your deployed backend URL (no trailing slash, no /api):
# e.g. VITE_API_URL=https://api.zinnia2026.example
VITE_API_URL=


# ==============================================================================
# Zinnia 2026 — environment template
# ==============================================================================
# LOCAL:  copy to .env at the repo root. Vite reads the VITE_* keys; Flask reads
#         the rest from its working directory. Do NOT create backend/.env — app.py
#         loads it last with override=True and it will shadow this file silently.
#
# VERCEL: the whole project deploys to Vercel — the site as a static build, the
#         Flask API as a serverless function at api/index.py. Set every variable
#         below in Project -> Settings -> Environment Variables. There is no
#         .env file in the deployment; the platform supplies them.
#
#         Without AUTH_SECRET_KEY and QR_SIGNING_SECRET the function will not
#         boot at all — both raise on import.
# ==============================================================================

# ------------------------------------------------------------------ frontend
# src/lib/supabase.ts throws at import time when these are missing, which takes
# the whole app down rather than degrading — so they must be set even for
# local UI work. Placeholder values keep it in offline mode.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_SUPABASE_DISABLE_REALTIME=true

# Where the browser sends /api/* in dev (vite proxies to this).
VITE_API_URL=http://127.0.0.1:5000

# D11 — replace with the current invite URL from WhatsApp once it stabilises.
VITE_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/DthX9rMcTk9BgLh3gQOHx6?s=sw&p=a&mlu=0&ilr=4
# Shown on the payment screen.
# The UPI id shown on the payment screen. It MUST match the account in
# src/assets/upi-qr-*.jpeg — participants scan one and read the other.
VITE_TREASURER_UPI_ID=
VITE_TREASURER_PAYEE_NAME=

# ------------------------------------------------------------------- backend
# backend/.env — the server refuses to start without the two secrets below.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# Signs admin bearer tokens (middleware/auth_middleware.py). Any long random
# string; rotating it signs every admin out.
AUTH_SECRET_KEY=

# Signs the master QR payload (services/passport_service.py).
QR_SIGNING_SECRET=

# Turn off the built-in seed admin accounts in services/auth_service.py once
# the passwords in admin_users have been rotated. See scripts/gen_admin_hashes.py.
ADMIN_DISABLE_SEED_FALLBACK=false

# Comma-separated allowlist in production; "*" is the dev fallback.
CORS_ORIGINS=*

# Public site URL — every emailed link is built from this.
# Production: https://zinnia-gcee.vercel.app
APP_BASE_URL=https://zinnia-gcee.vercel.app
REGISTRATION_FEE_PER_HEAD=250
RATE_LIMIT_PER_MINUTE=60

# Outbound email (participant confirmations, payment rejections).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Zinnia 2026 <zinnia2026@gcee.ac.in>

# ==============================================================================
# PREREQUISITE FOR THE ADMIN PANEL
#   The live participant model lives in the `zin26` Postgres schema. It must be
#   listed under Supabase Dashboard -> Settings -> API -> Exposed schemas, or
#   every zin26 call returns PGRST106 ("Invalid schema") and the panel shows
#   nothing. services/zin26_db.zin26_available() reports this at startup.
# ==============================================================================

# --- WhatsApp participants group ------------------------------------------
# TWO names for one value: the browser can only see VITE_-prefixed vars, and
# the Flask emailer only sees the unprefixed one. Change them together or the
# link on the site and the link in the confirmation email will disagree.
# Rotating the group? This is the only place to edit.
WHATSAPP_GROUP_URL=https://chat.whatsapp.com/DthX9rMcTk9BgLh3gQOHx6?s=sw&p=a&mlu=0&ilr=4
VITE_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/DthX9rMcTk9BgLh3gQOHx6?s=sw&p=a&mlu=0&ilr=4

# --- Realtime -------------------------------------------------------------
# The legacy store.ts subscribes to public-schema tables that migration 004
# revoked from anon, so every page load logs failed attempts. The live
# participant flow does not use realtime at all; turning it off removes the
# noise without losing anything.
VITE_SUPABASE_DISABLE_REALTIME=true
